#!/bin/sh
# Pre-commit hook: run golangci-lint before committing
set -e

if ! command -v golangci-lint > /dev/null 2>&1; then
  echo "golangci-lint not found. Skipping lint check."
  echo "Install: https://golangci-lint.run/welcome/install/"
  exit 0
fi

echo "Running golangci-lint..."
golangci-lint run ./...

if command -v actionlint > /dev/null 2>&1; then
  echo "Running actionlint..."
  actionlint .github/workflows/*.yml
else
  echo "actionlint not found. Skipping. Install: go install github.com/rhysd/actionlint/cmd/actionlint@latest"
fi
